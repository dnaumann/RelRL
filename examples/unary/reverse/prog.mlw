module State
  use prelude.Prelude
  use prelude.PreRefperm
  use reverse_theory.Reverse_theory
  
  type reftype = 
      | List
      | Node
  
  type state = private {
              mutable ghost alloct : M.t reftype;
              mutable value : M.t int;
              mutable nxt : M.t reference;
              mutable ghost pos : M.t int;
              mutable head : M.t reference;
              mutable ghost rep : M.t rgn;
              mutable ghost contents : M.t intSeq
              }
    invariant { not (M.mem null alloct) }
    invariant {
      forall p : reference.
        ((M.mem p alloct) ->
           (((alloct[p]) = List) ->
              (((M.mem p head) /\ (M.mem p rep) /\ (M.mem p contents)) /\
                 ((((head[p]) = null) \/ ((M.mem (head[p]) alloct) /\ ((alloct[head[p]]) = Node)))
                    /\
                    (forall q : reference. ((Rgn.mem q (rep[p])) -> ((q = null) \/ (M.mem q alloct)))))))) }
    invariant {
      forall p : reference.
        ((M.mem p alloct) ->
           (((alloct[p]) = Node) ->
              (((M.mem p value) /\ (M.mem p nxt) /\ (M.mem p pos)) /\
                 (((nxt[p]) = null) \/ ((M.mem (nxt[p]) alloct) /\ ((alloct[nxt[p]]) = Node)))))) }
    invariant { not (M.mem null value) }
    invariant { not (M.mem null nxt) }
    invariant { not (M.mem null pos) }
    invariant { not (M.mem null head) }
    invariant { not (M.mem null rep) }
    invariant { not (M.mem null contents) }
    by
      { alloct = (().M.create) ;
        value = (().M.create) ;
        nxt = (().M.create) ;
        pos = (().M.create) ;
        head = (().M.create) ;
        rep = (().M.create) ;
        contents = (().M.create) }
  
  predicate isAllocated (s: state) (p: reference) = M.mem p s.alloct
  
  predicate isValidRgn (s: state) (r: rgn) = forall q : reference. ((Rgn.mem q r) -> ((q = null) \/ (M.mem q s.alloct)))
  
  predicate typeofRgn (s: state) (r: rgn) (types: L.list reftype) =
    forall p : reference. ((Rgn.mem p r) -> ((p = null) \/ ((M.mem p s.alloct) /\ (L.mem (s.alloct[p]) types))))
  
  predicate hasListType (s: state) (p: reference) = ((p = null) \/ ((M.mem p s.alloct) /\ ((s.alloct[p]) = List)))
  
  predicate hasNodeType (s: state) (p: reference) = ((p = null) \/ ((M.mem p s.alloct) /\ ((s.alloct[p]) = Node)))
  
  predicate okRefperm (sl: state) (sr: state) (pi: PreRefperm.t) =
    ((forall p : reference. ((M.mem p pi.lor) -> (M.mem p sl.alloct))) /\
       ((forall q : reference. ((M.mem q pi.rol) -> (M.mem q sr.alloct))) /\
          (forall p : reference, q : reference. ((M.mem p pi.lor) -> (((pi.lor[p]) = q) -> ((sl.alloct[p]) = (sr.alloct[q])))))))
  
  val mk_List (s: state) : reference
    writes { s.alloct, s.head, s.rep, s.contents }
    ensures { not (M.mem result (old s.alloct)) }
    
    ensures { (s.alloct = (M.add result List (old s.alloct))) }
    
    ensures { forall p : reference. ((M.mem p (old s.alloct)) -> ((M.mem p s.alloct) /\ (((old s.alloct)[p]) = (s.alloct[p])))) }
    
    ensures { (result <> null) }
    
    ensures { hasListType s result }
    
    ensures { (s.head = (M.add result null (old s.head))) }
    
    ensures { (s.rep = (M.add result emptyRgn (old s.rep))) }
    
    ensures { (s.contents = (M.add result emptySeq (old s.contents))) }
  
  val mk_Node (s: state) : reference
    writes { s.alloct, s.value, s.nxt, s.pos }
    ensures { not (M.mem result (old s.alloct)) }
    
    ensures { (s.alloct = (M.add result Node (old s.alloct))) }
    
    ensures { forall p : reference. ((M.mem p (old s.alloct)) -> ((M.mem p s.alloct) /\ (((old s.alloct)[p]) = (s.alloct[p])))) }
    
    ensures { (result <> null) }
    
    ensures { hasNodeType s result }
    
    ensures { (s.value = (M.add result 0 (old s.value))) }
    
    ensures { (s.nxt = (M.add result null (old s.nxt))) }
    
    ensures { (s.pos = (M.add result 0 (old s.pos))) }
  
  val set_value (s: state) (o: reference) (v: int) : unit
    requires { (o <> null) }
    requires { hasNodeType s o }
    writes { s.value }
    ensures { (s.value = (M.add o v (old s.value))) }
  
  val set_nxt (s: state) (o: reference) (v: reference) : unit
    requires { (o <> null) }
    requires { hasNodeType s o }
    requires { hasNodeType s v }
    writes { s.nxt }
    ensures { (s.nxt = (M.add o v (old s.nxt))) }
  
  val set_pos (s: state) (o: reference) (ghost v: int) : unit
    requires { (o <> null) }
    requires { hasNodeType s o }
    writes { s.pos }
    ensures { (s.pos = (M.add o v (old s.pos))) }
  
  val set_head (s: state) (o: reference) (v: reference) : unit
    requires { (o <> null) }
    requires { hasListType s o }
    requires { hasNodeType s v }
    writes { s.head }
    ensures { (s.head = (M.add o v (old s.head))) }
  
  val set_rep (s: state) (o: reference) (ghost v: rgn) : unit
    requires { (o <> null) }
    requires { hasListType s o }
    requires { isValidRgn s v }
    writes { s.rep }
    ensures { (s.rep = (M.add o v (old s.rep))) }
  
  val set_contents (s: state) (o: reference) (ghost v: intSeq) : unit
    requires { (o <> null) }
    requires { hasListType s o }
    writes { s.contents }
    ensures { (s.contents = (M.add o v (old s.contents))) }
  
  function img_value : state -> (rgn -> rgn)
  
  axiom img_value_ax: forall s : state, r : rgn. ((img_value s r) = emptyRgn)
  
  function img_rep : state -> (rgn -> rgn)
  
  axiom img_rep_ax:
    forall s : state, r : rgn, p : reference.
      ((Rgn.mem p (img_rep s r)) <->
         (exists q : reference. ((M.mem q s.alloct) /\ (((s.alloct[q]) = List) /\ ((Rgn.mem q r) /\ (Rgn.mem p (s.rep[q])))))))
  
  function img_pos : state -> (rgn -> rgn)
  
  axiom img_pos_ax: forall s : state, r : rgn. ((img_pos s r) = emptyRgn)
  
  function img_nxt : state -> (rgn -> rgn)
  
  axiom img_nxt_ax:
    forall s : state, r : rgn, p : reference.
      ((Rgn.mem p (img_nxt s r)) <->
         (exists q : reference. ((M.mem q s.alloct) /\ (((s.alloct[q]) = Node) /\ ((Rgn.mem q r) /\ (p = (s.nxt[q])))))))
  
  function img_head : state -> (rgn -> rgn)
  
  axiom img_head_ax:
    forall s : state, r : rgn, p : reference.
      ((Rgn.mem p (img_head s r)) <->
         (exists q : reference. ((M.mem q s.alloct) /\ (((s.alloct[q]) = List) /\ ((Rgn.mem q r) /\ (p = (s.head[q])))))))
  
  function img_contents : state -> (rgn -> rgn)
  
  axiom img_contents_ax: forall s : state, r : rgn. ((img_contents s r) = emptyRgn)
  
  predicate alloc_does_not_shrink (pre: state) (post: state) =
    forall p : reference. ((M.mem p pre.alloct) -> ((M.mem p post.alloct) /\ ((pre.alloct[p]) = (post.alloct[p]))))
  
  predicate wr_frame_head (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = List) -> ((not (Rgn.mem p r)) -> ((pre.head[p]) = (post.head[p])))))
  
  predicate wr_frame_rep (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = List) -> ((not (Rgn.mem p r)) -> ((pre.rep[p]) = (post.rep[p])))))
  
  predicate wr_frame_contents (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = List) -> ((not (Rgn.mem p r)) -> ((pre.contents[p]) = (post.contents[p])))))
  
  predicate wr_frame_value (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = Node) -> ((not (Rgn.mem p r)) -> ((pre.value[p]) = (post.value[p])))))
  
  predicate wr_frame_nxt (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = Node) -> ((not (Rgn.mem p r)) -> ((pre.nxt[p]) = (post.nxt[p])))))
  
  predicate wr_frame_pos (pre: state) (post: state) (r: rgn) =
    forall p : reference.
      ((M.mem p pre.alloct) -> (((post.alloct[p]) = Node) -> ((not (Rgn.mem p r)) -> ((pre.pos[p]) = (post.pos[p])))))
  
  predicate agree_value (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasNodeType sl o) ->
                ((Rgn.mem o w) -> ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] ((sl.value[o]) = (sr.value[pi.lor[o]])))))))))
  
  predicate agree_rep (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasListType sl o) ->
                ((Rgn.mem o w) ->
                   ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] (PreRefperm.idRgn pi (sl.rep[o]) (sr.rep[pi.lor[o]])))))))))
  
  predicate agree_pos (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasNodeType sl o) ->
                ((Rgn.mem o w) -> ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] ((sl.pos[o]) = (sr.pos[pi.lor[o]])))))))))
  
  predicate agree_nxt (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasNodeType sl o) ->
                ((Rgn.mem o w) ->
                   ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] (PreRefperm.idRef pi (sl.nxt[o]) (sr.nxt[pi.lor[o]])))))))))
  
  predicate agree_head (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasListType sl o) ->
                ((Rgn.mem o w) ->
                   ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] (PreRefperm.idRef pi (sl.head[o]) (sr.head[pi.lor[o]])))))))))
  
  predicate agree_contents (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    ((okRefperm sl sr pi) /\
       (forall o : reference.
          ((isAllocated sl o) ->
             ((hasListType sl o) ->
                ((Rgn.mem o w) -> ((M.mem o pi.lor) /\ ([@expl:sl(o) ~ sr(pi(o))] ((sl.contents[o]) = (sr.contents[pi.lor[o]])))))))))
  
  predicate agree_allfields (sl: state) (sr: state) (pi: PreRefperm.t) (w: rgn) =
    (agree_head sl sr pi w)
      /\
      (agree_rep sl sr pi w)
      /\
      (agree_contents sl sr pi w)
      /\
      (agree_value sl sr pi w)
      /\
      (agree_nxt sl sr pi w)
      /\
      (agree_pos sl sr pi w)
end

module MAIN
  use prelude.Prelude
  use State
end

module REVERSE
  use prelude.Prelude
  use State
  use export reverse_theory.Reverse_theory
  
  predicate segment (s: state) (head1: reference) (nodes: rgn) (xs: intSeq) (lo: int) (hi: int) =
    (hasNodeType s head1)
      ->
      (0 <= lo)
      /\
      (lo <= hi)
      /\
      (hi <= (xs.seqLength))
      /\
      (typeofRgn s nodes (L.Cons Node L.Nil))
      /\
      (not (Rgn.mem null nodes))
      /\
      (((lo = hi) /\ (head1 = null) /\ (nodes = emptyRgn))
         \/
         (lo < hi)
         /\
         (head1 <> null)
         /\
         (Rgn.mem head1 nodes)
         /\
         ((s.pos[head1]) = lo))
      /\
      (forall p : reference.
         (isAllocated s p)
           ->
           (hasNodeType s p)
           ->
           (Rgn.mem p nodes)
           ->
           (let i = s.pos[p] in
            (lo <= i)
              /\
              (i < hi)
              /\
              ((s.value[p]) = (seqNth i xs))
              /\
              (let next = s.nxt[p] in
               ((i = hi - 1) /\ (next = null)) \/ (i < hi - 1) /\ (next <> null) /\ (Rgn.mem next nodes) /\ ((s.pos[next]) = i + 1))))
      /\
      (forall p : reference, q : reference.
         (isAllocated s p)
           ->
           (hasNodeType s p)
           ->
           (Rgn.mem p nodes)
           ->
           (isAllocated s q)
           ->
           (hasNodeType s q)
           ->
           (Rgn.mem q nodes)
           ->
           (let i = s.pos[p] in
            let j = s.pos[q] in
            (i = j) -> (p = q)))
  
  lemma segment_tail:
    forall s : state.
      forall head1 : reference, nodes : rgn, xs : intSeq, lo : int, hi : int.
        (isAllocated s head1)
          ->
          (hasNodeType s head1)
          ->
          ((head1 <> null) /\ (segment s head1 nodes xs lo hi))
          ->
          (let next = s.nxt[head1] in
           segment s next (Rgn.diff nodes (head1.singleton)) xs (lo + 1) hi)
  
  lemma segment_cons:
    forall s : state.
      forall head1 : reference, tail : reference, nodes : rgn, xs : intSeq, lo : int, hi : int.
        (isAllocated s head1)
          ->
          (hasNodeType s head1)
          ->
          (hasNodeType s tail)
          ->
          ((0 < lo)
             /\
             (head1 <> null)
             /\
             (not (Rgn.mem head1 nodes))
             /\
             ((s.pos[head1]) = lo - 1)
             /\
             ((s.value[head1]) = (seqNth (lo - 1) xs))
             /\
             ((s.nxt[head1]) = tail)
             /\
             (segment s tail nodes xs lo hi))
          ->
          (segment s head1 (Rgn.union (head1.singleton) nodes) xs (lo - 1) hi)
  
  predicate listrep (s: state) (self: reference) =
    (hasListType s self)
      ->
      (self <> null)
      /\
      (let head1 = s.head[self] in
       let nodes = s.rep[self] in
       let xs = s.contents[self] in
       segment s head1 nodes xs 0 (xs.seqLength))
  
  val reverse (s: state) (self: reference) : unit
    requires { hasListType s self }
    requires { (self <> null) }
    requires { listrep s self }
    writes { s.head, s.contents, s.nxt, s.pos }
    ensures { (result = ()) }
    
    ensures { [@expl:wr {self}`head] (wr_frame_head (old s) s (self.singleton)) }
    
    ensures { [@expl:wr {self}`contents] (wr_frame_contents (old s) s (self.singleton)) }
    
    ensures { [@expl:wr {self}`rep`nxt] (wr_frame_nxt (old s) s (s.rep[self])) }
    
    ensures { [@expl:wr {self}`rep`pos] (wr_frame_pos (old s) s (s.rep[self])) }
    
    ensures { listrep s self }
    
    ensures { let xs = old (s.contents[self]) in
              (s.contents[self])
              =
              (xs.rev) }
    
    ensures { let nodes = old (s.rep[self]) in
              (s.rep[self])
              =
              nodes }
end

module Reverse
  use prelude.Prelude
  use State
  use REVERSE
  
  let reverse (s : state) (self : reference) : unit
    requires { hasListType s self }
    requires { (self <> null) }
    requires { REVERSE.listrep s self }
    writes { s.contents, s.head, s.nxt, s.pos }
    ensures { (result = ()) }
    
    ensures { [@expl:wr {self}`rep`pos] (wr_frame_pos (old s) s (s.rep[self])) }
    
    ensures { [@expl:wr {self}`rep`nxt] (wr_frame_nxt (old s) s (s.rep[self])) }
    
    ensures { [@expl:wr {self}`contents] (wr_frame_contents (old s) s (self.singleton)) }
    
    ensures { [@expl:wr {self}`head] (wr_frame_head (old s) s (self.singleton)) }
    
    ensures { REVERSE.listrep s self }
    
    ensures { let xs = old (s.contents[self]) in
              (s.contents[self])
              =
              (xs.REVERSE.rev) }
    
    ensures { let nodes = old (s.rep[self]) in
              (s.rep[self])
              =
              nodes }
    diverges
  = label INIT in
      let result = ref () in
      let self = ref self in
      let current = ref null in
      assert { hasNodeType s (! current) };
      (let previous = ref null in
       assert { hasNodeType s (! previous) };
       (let next = ref null in
        assert { hasNodeType s (! next) };
        (let ghost todo = ref emptyRgn in
         assert { isValidRgn s (! todo) };
         (let ghost doneNodes = ref emptyRgn in
          assert { isValidRgn s (! doneNodes) };
          (let ghost original = ref (any intSeq) in
           let ghost reversed = ref (any intSeq) in
           let ghost size = ref 0 in
           let ghost k = ref 0 in
           assert {
             (Rgn.mem (! self) (((! self).singleton) at INIT))
               \/
               (not (Rgn.mem (! self) (s.alloct.M.domain at INIT)))
               \/
               ((! self) = null) };
           (original := ([@expl:original := self.contents] (s.contents[! self])));
           (reversed := ([@expl:reversed := rev(original)] ((! original).REVERSE.rev)));
           (size := ([@expl:size := seqLength(original)] ((! original).REVERSE.seqLength)));
           (k := ([@expl:k := 0] 0));
           assert {
             (Rgn.mem (! self) (((! self).singleton) at INIT))
               \/
               (not (Rgn.mem (! self) (s.alloct.M.domain at INIT)))
               \/
               ((! self) = null) };
           (current := ([@expl:current := self.head] (s.head[! self])));
           (previous := ([@expl:previous := null] null));
           assert {
             (Rgn.mem (! self) (((! self).singleton) at INIT))
               \/
               (not (Rgn.mem (! self) (s.alloct.M.domain at INIT)))
               \/
               ((! self) = null) };
           (todo := ([@expl:todo := self.rep] (s.rep[! self])));
           (doneNodes := ([@expl:doneNodes := {}] emptyRgn));
           while ((! current) <>. null) do
             invariant {
               [@expl:locals type invariant]
               ((hasNodeType s (! current))
                  /\
                  (isValidRgn s (! doneNodes))
                  /\
                  (hasNodeType s (! next))
                  /\
                  (hasNodeType s (! previous))
                  /\
                  (hasListType s (! self))
                  /\
                  (isValidRgn s (! todo))) }
             invariant { alloc_does_not_shrink (old s) s }
             invariant { [@expl:wr {self}`rep`nxt] (wr_frame_nxt (old s) s (s.rep[! self])) }
             invariant { [@expl:wr {self}`rep`pos] (wr_frame_pos (old s) s (s.rep[! self])) }
             invariant { (0 <= (! k)) /\ ((! k) <= (! size)) }
             invariant { ((! size) = ((! original).REVERSE.seqLength)) /\ ((! size) = ((! reversed).REVERSE.seqLength)) }
             invariant { let xs = old (s.contents[! self]) in
                         (! original)
                         =
                         xs }
             invariant { (! reversed) = ((! original).REVERSE.rev) }
             invariant { REVERSE.segment s (! current) (! todo) (! original) (! k) (! size) }
             invariant { REVERSE.segment s (! previous) (! doneNodes) (! reversed) ((! size) - (! k)) (! size) }
             invariant { (! todo) \# (! doneNodes) }
             invariant { let nodes = s.rep[! self] in
                         nodes
                         =
                         (Rgn.union (! todo) (! doneNodes)) }
             assert { (Rgn.mem (! current) (! todo)) /\ ((s.pos[! current]) = (! k)) /\ ((! k) < (! size)) };
             assert {
               (Rgn.mem (! current) ((s.rep[! self]) at INIT))
                 \/
                 (not (Rgn.mem (! current) (s.alloct.M.domain at INIT)))
                 \/
                 ((! current) = null) };
             (next := ([@expl:next := current.nxt] (s.nxt[! current])));
             assert { REVERSE.segment s (! next) (Rgn.diff (! todo) ((! current).singleton)) (! original) ((! k) + 1) (! size) };
             ([@expl:current.nxt := previous] (set_nxt s (! current) (! previous)));
             ([@expl:current.pos := size - k - 1] (set_pos s (! current) (((! size) - (! k)) - 1)));
             assert { REVERSE.segment s (! next) (Rgn.diff (! todo) ((! current).singleton)) (! original) ((! k) + 1) (! size) };
             assert { REVERSE.segment s (! previous) (! doneNodes) (! reversed) ((! size) - (! k)) (! size) };
             assert {
               REVERSE.segment
                  s
                  (! current)
                  (Rgn.union ((! current).singleton) (! doneNodes))
                  (! reversed)
                  (((! size) - (! k)) - 1)
                  (! size) };
             (todo := ([@expl:todo := todo diff {current}] (Rgn.diff (! todo) ((! current).singleton))));
             (doneNodes := ([@expl:doneNodes := doneNodes union {current}] (Rgn.union (! doneNodes) ((! current).singleton))));
             (previous := ([@expl:previous := current] (! current)));
             (current := ([@expl:current := next] (! next)));
             (k := ([@expl:k := k + 1] ((! k) + 1)))
           done;
           ([@expl:self.head := previous] (set_head s (! self) (! previous)));
           ([@expl:self.contents := reversed] (set_contents s (! self) (! reversed)));
           (! result))))))
end

